<Window x:Class="HyperTrunk.AddVlanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add VLAN"
        Height="320"
        Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
   

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="130"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- NOM DU VLAN -->

        <TextBlock Text="Nom du VLAN"
                   Grid.Row="0"
                   VerticalAlignment="Center"/>

        <TextBox Name="txtNom"
                 Grid.Row="0"
                 Grid.Column="1"
                 VerticalContentAlignment="Center"
                 Background="#EAEAEA"
                 Padding="6,0"/>

        <!-- GROUPE LUMINEX (couleur + VLAN ID auto) -->

        <TextBlock Text="Groupe Luminex"
                   Grid.Row="1"
                   VerticalAlignment="Center"/>

        <ComboBox Name="cmbGroup"
                  Grid.Row="1"
                  Grid.Column="1"
                  SelectionChanged="cmbGroup_SelectionChanged">

            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Display}"
                               />
                </DataTemplate>
            </ComboBox.ItemTemplate>

            <ComboBox.ItemContainerStyle>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Background" Value="{Binding ColorHex}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="8,5"/>
                </Style>
            </ComboBox.ItemContainerStyle>

        </ComboBox>

        <!-- VLAN ID (rempli automatiquement) -->

        <TextBlock Text="VLAN ID"
                   Grid.Row="2"
                   VerticalAlignment="Center"/>

        <TextBox Name="txtVlanId"
                 Grid.Row="2"
                 Grid.Column="1"
                 IsReadOnly="True"
                 VerticalContentAlignment="Center"
                 Background="#AAAAAA"
                 Padding="6,0"/>

        <!-- ADRESSE IP -->

        <TextBlock Text="Adresse IP"
                   Grid.Row="3"
                   VerticalAlignment="Center"/>

        <TextBox Name="txtIp"
                 Grid.Row="3"
                 Grid.Column="1"
                 VerticalContentAlignment="Center"
                 Background="#EAEAEA"
                 Padding="6,0"/>

        <!-- MASQUE -->

        <TextBlock Text="Masque"
                   Grid.Row="4"
                   VerticalAlignment="Center"/>

        <ComboBox Name="cmbMasque"
                  Grid.Row="4"
                  Grid.Column="1">
            <ComboBoxItem Content="255.255.255.0 (/24)"   Tag="255.255.255.0"/>
            <ComboBoxItem Content="255.255.0.0 (/16)"     Tag="255.255.0.0"/>
            <ComboBoxItem Content="255.0.0.0 (/8)"        Tag="255.0.0.0"/>
            <ComboBoxItem Content="255.255.255.128 (/25)" Tag="255.255.255.128"/>
            <ComboBoxItem Content="255.255.255.192 (/26)" Tag="255.255.255.192"/>
        </ComboBox>

        <!-- MESSAGE D'ERREUR -->

        <TextBlock Name="txtErreur"
                   Grid.Row="5"
                   Grid.Column="1"
                   Foreground="Red"
                   FontSize="12"
                   Margin="0,4,0,0"
                   Visibility="Collapsed"
                   TextWrapping="Wrap"/>

        <!-- BOUTON CRÉER -->

        <Button Name="btnCreate"
                Content="Créer le VLAN"
                Click="btnCreate_Click"
                Height="36"
                Grid.Row="5"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                VerticalAlignment="Bottom"
                Margin="0,0,0,4"/>

    </Grid>

</Window>