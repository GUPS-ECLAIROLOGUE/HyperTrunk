<Window x:Class="HyperTrunk.Views.AddVlanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add VLAN"
        Height="320"
        Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="130"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- NOM DU VLAN -->

        <TextBlock Text="VLAN name"
                   Grid.Row="0"
                   VerticalAlignment="Center"/>

        <TextBox Text="{Binding VlanName, UpdateSourceTrigger=PropertyChanged}"
                 IsReadOnly="{Binding IsNameReadOnly}"
                 Grid.Row="0"
                 Grid.Column="1"
                 VerticalContentAlignment="Center"
                 Background="#EAEAEA"
                 Padding="6,0"/>

        <!-- GROUPE LUMINEX (couleur + VLAN ID auto) -->

        <TextBlock Text="Luminex group"
                   Grid.Row="1"
                   VerticalAlignment="Center"/>

        <ComboBox ItemsSource="{Binding Groups}"
                  SelectedItem="{Binding SelectedGroup}"
                  IsEnabled="{Binding IsGroupSelectionEnabled}"
                  Grid.Row="1"
                  Grid.Column="1">

            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Display}"/>
                </DataTemplate>
            </ComboBox.ItemTemplate>

            <ComboBox.ItemContainerStyle>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Background" Value="{Binding ColorHex}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="8,5"/>
                </Style>
            </ComboBox.ItemContainerStyle>

        </ComboBox>

        <!-- VLAN ID (rempli automatiquement) -->

        <TextBlock Text="VLAN ID"
                   Grid.Row="2"
                   VerticalAlignment="Center"/>

        <TextBox Text="{Binding VlanIdText, Mode=OneWay}"
                 Grid.Row="2"
                 Grid.Column="1"
                 IsReadOnly="True"
                 VerticalContentAlignment="Center"
                 Background="#AAAAAA"
                 Padding="6,0"/>

        <!-- ADRESSE IP -->

        <TextBlock Text="IP address"
                   Grid.Row="3"
                   VerticalAlignment="Center"/>

        <TextBox Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}"
                 Grid.Row="3"
                 Grid.Column="1"
                 VerticalContentAlignment="Center"
                 Background="#EAEAEA"
                 Padding="6,0"/>

        <!-- MASQUE -->

        <TextBlock Text="Subnet mask"
                   Grid.Row="4"
                   VerticalAlignment="Center"/>

        <ComboBox ItemsSource="{Binding MaskOptions}"
                  SelectedItem="{Binding SelectedMask}"
                  DisplayMemberPath="Display"
                  Grid.Row="4"
                  Grid.Column="1"/>

        <!-- MESSAGE D'ERREUR -->

        <TextBlock Text="{Binding ErrorMessage}"
                   Grid.Row="5"
                   Grid.Column="1"
                   Foreground="Red"
                   FontSize="12"
                   Margin="0,4,0,0"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToVisibilityConverter}}"
                   TextWrapping="Wrap"/>

        <!-- BOUTON CRÉER -->

        <Button Content="Create VLAN"
                Command="{Binding CreateCommand}"
                Height="36"
                Grid.Row="5"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                VerticalAlignment="Bottom"
                Margin="0,0,0,4"/>

    </Grid>

</Window>
