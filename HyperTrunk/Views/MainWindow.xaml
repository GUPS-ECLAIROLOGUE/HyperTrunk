<Window x:Class="HyperTrunk.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HyperTrunk"
        Icon="/HyperTrunk_P.ico"
        Height="820"
        Width="800"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="220"/>
            <RowDefinition Height="220"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===================== -->
        <!-- INDICATEUR "EN COURS" -->
        <!-- ===================== -->

        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Margin="0,0,0,10"
                    Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">

            <ProgressBar IsIndeterminate="True" Width="150" Height="16" Margin="0,0,10,0"/>
            <TextBlock Text="{Binding BusyMessage}"
                       VerticalAlignment="Center"
                       FontStyle="Italic"
                       Foreground="Gray"/>

        </StackPanel>

        <!-- ===================== -->
        <!-- CARTES RÉSEAU         -->
        <!-- ===================== -->

        <Border Grid.Row="1"
                BorderBrush="Gray"
                BorderThickness="1"
                CornerRadius="4"
                Padding="15"
                Margin="0,0,0,15">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>

                <StackPanel>

                    <TextBlock Text="Network Adapters"
                               FontSize="16"
                               FontWeight="Bold"
                               Margin="0,0,0,10"/>

                    <ListBox Name="lstAdapters"
                             ItemsSource="{Binding Adapters}"
                             SelectedItem="{Binding SelectedAdapter}"
                             Height="140">

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Display}"
                                           Margin="5"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>

                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">

                                <Setter Property="Margin"            Value="0,0,0,4"/>
                                <Setter Property="FocusVisualStyle"  Value="{x:Null}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border Name="bd"
                            Background="{TemplateBinding Background}"
                            Padding="2">
                                                <ContentPresenter/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>

                                <Style.Triggers>

                                    <!-- CARTE AVEC VSWITCH : fond vert clair -->
                                    <DataTrigger Binding="{Binding HasSwitch}" Value="True">
                                        <Setter Property="Background" Value="#AAFFAA"/>
                                        <Setter Property="Foreground" Value="Black"/>
                                    </DataTrigger>

                                    <!-- SÉLECTION NORMALE : bleu clair -->
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="LightBlue"/>
                                        <Setter Property="Foreground" Value="Black"/>
                                    </Trigger>

                                    <!-- SÉLECTION + VSWITCH : vert -->
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding HasSwitch}" Value="True"/>
                                            <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsSelected}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Background" Value="LightGreen"/>
                                        <Setter Property="Foreground" Value="Black"/>
                                    </MultiDataTrigger>

                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>

                    </ListBox>

                </StackPanel>

                <StackPanel Grid.Column="1"
                            Margin="15,31,0,3">

                    <Button Content="Create vSwitch"
                            Command="{Binding CreateSwitchCommand}"
                            Margin="0,0,0,4"
                            Height="40"/>

                    <Button Content="Remove vSwitch"
                            Command="{Binding DeleteSwitchCommand}"
                            Margin="0,0,0,4"
                            Height="40"/>

                    <Button Content="Refresh"
                            Command="{Binding LoadAdaptersCommand}"
                            Height="40"/>

                </StackPanel>

            </Grid>

        </Border>

        <!-- ===================== -->
        <!-- VLANs                 -->
        <!-- ===================== -->

        <Border Grid.Row="2"
                BorderBrush="Gray"
                BorderThickness="1"
                CornerRadius="4"
                Padding="15"
                Margin="0,0,0,15">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>

                <StackPanel>

                    <TextBlock Text="Virtual Adapters (VLANs)"
                               FontSize="16"
                               FontWeight="Bold"
                               Margin="0,0,0,10"/>

                    <ListBox Name="lstVlans"
                             ItemsSource="{Binding Vlans}"
                             SelectedItem="{Binding SelectedVlan}"
                             Height="140">

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding ColorHex}"
                                        CornerRadius="4"
                                        Padding="8,4"
                                        Margin="0,1">
                                    <TextBlock Text="{Binding Display}"
                                               Foreground="White"
                                               FontWeight="SemiBold"/>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>

                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding"                    Value="0"/>
                                <Setter Property="Margin"                     Value="0,0,0,2"/>
                            </Style>
                        </ListBox.ItemContainerStyle>

                    </ListBox>

                </StackPanel>

                <StackPanel Grid.Column="1"
                            Margin="15,32,0,0">

                    <Button Content="Add VLAN"
                            Command="{Binding OpenAddVlanCommand}"
                            Margin="0,0,0,4"
                            Height="40"/>

                    <!--   <Button Content="Edit VLAN"
                            Command="{Binding OpenEditVlanCommand}"
                            Margin="0,0,0,4"/> -->

                    <Button Content="Remove VLAN"
                            Command="{Binding DeleteVlanCommand}"
                            Margin="0,0,0,4"
                            Height="40"/>

                    <Button Content="Refresh"
                            Command="{Binding LoadVlansCommand}"
                            Height="40"/>

                </StackPanel>

            </Grid>

        </Border>

        <!-- ===================== -->
        <!-- CONSOLE               -->
        <!-- ===================== -->

        <Border Grid.Row="3"
                BorderBrush="Gray"
                BorderThickness="1"
                CornerRadius="4"
                Padding="10">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Console"
                           FontSize="16"
                           FontWeight="Bold"/>

                <ListBox Name="lstConsole"
                         Grid.Row="1"
                         ItemsSource="{Binding LogEntries}"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         FontFamily="Consolas"
                         FontSize="13">

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Focusable" Value="False"/>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Timestamp, StringFormat='[HH:mm:ss] '}"
                                           Foreground="Gray"/>
                                <TextBlock Text="{Binding Message}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="Black"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCommand}" Value="True">
                                                    <Setter Property="Foreground" Value="#007800"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="Warn">
                                                    <Setter Property="Foreground" Value="DarkOrange"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="Error">
                                                    <Setter Property="Foreground" Value="Red"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>

                </ListBox>

            </Grid>

        </Border>

        <!-- ===================== -->
        <!-- VOILE ADMIN           -->
        <!-- ===================== -->

        <Grid Grid.RowSpan="4"
              Background="#80000000"
              Visibility="{Binding IsAdmin, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
              Panel.ZIndex="99">

            <Border Background="White"
            CornerRadius="8"
            Padding="40,30"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

                <StackPanel HorizontalAlignment="Center">

                    <TextBlock Text="🔒"
                       FontSize="48"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,10"/>

                    <TextBlock Text="Droits administrateur requis !"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="Red"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,8"/>

                    <TextBlock Text="Relancez HyperTrunk avec clic droit → Exécuter en tant qu'administrateur."
                       FontSize="13"
                       Foreground="Gray"
                       HorizontalAlignment="Center"/>

                </StackPanel>

            </Border>

        </Grid>

        <!-- ===================== -->
        <!-- VOILE HYPER-V         -->
        <!-- ===================== -->
        <Grid Grid.RowSpan="4"
              Background="#80000000"
              Visibility="{Binding IsHyperVAvailable, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
              Panel.ZIndex="99">

            <Border Background="White"
            CornerRadius="8"
            Padding="40,30"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

                <StackPanel HorizontalAlignment="Center">

                    <TextBlock Text="⚠"
                       FontSize="48"
                       HorizontalAlignment="Center"
                       Foreground="Red"
                       Margin="0,0,0,10"/>

                    <TextBlock Text="Hyper-V n'est pas activé sur cet ordinateur !"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="Red"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,8"/>

                    <TextBlock Text="Activez Hyper-V dans les fonctionnalités Windows puis redémarrez."
                       FontSize="13"
                       Foreground="Gray"
                       HorizontalAlignment="Center"/>

                </StackPanel>

            </Border>

        </Grid>
    </Grid>

</Window>
