<Window x:Class="HyperTrunk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HyperTrunk"
        Icon="HyperTrunk_P.ico"
        Height="800"
        Width="800"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="220"/>
            <RowDefinition Height="220"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===================== -->
        <!-- CARTES RÉSEAU         -->
        <!-- ===================== -->

        <Border Grid.Row="1"
                BorderBrush="Gray"
                BorderThickness="1"
                CornerRadius="4"
                Padding="15"
                Margin="0,0,0,15">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>

                <StackPanel>

                    <TextBlock Text="Network Adapters"
                               FontSize="16"
                               FontWeight="Bold"
                               Margin="0,0,0,10"/>

                    <ListBox Name="lstAdapters"
                             SelectionChanged="lstAdapters_SelectionChanged"
                             Height="140">

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Display}"
                                           Margin="5"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>

                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">

                                <Setter Property="Margin"            Value="0,0,0,4"/>
                                <Setter Property="FocusVisualStyle"  Value="{x:Null}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border Name="bd"
                            Background="{TemplateBinding Background}"
                            Padding="2">
                                                <ContentPresenter/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>

                                <Style.Triggers>

                                    <!-- CARTE AVEC VSWITCH : fond vert clair -->
                                    <DataTrigger Binding="{Binding HasSwitch}" Value="True">
                                        <Setter Property="Background" Value="#AAFFAA"/>
                                        <Setter Property="Foreground" Value="Black"/>
                                    </DataTrigger>

                                    <!-- SÉLECTION NORMALE : bleu clair -->
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="LightBlue"/>
                                        <Setter Property="Foreground" Value="Black"/>
                                    </Trigger>

                                    <!-- SÉLECTION + VSWITCH : vert -->
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding HasSwitch}" Value="True"/>
                                            <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsSelected}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Background" Value="LightGreen"/>
                                        <Setter Property="Foreground" Value="Black"/>
                                    </MultiDataTrigger>

                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>

                    </ListBox>

                </StackPanel>

                <StackPanel Grid.Column="1"
                            Margin="15,31,0,3">

                    <Button Content="Create vSwitch"
                            Click="btnCreateSwitch_Click"
                            Margin="0,0,0,4"
                            Height="40"/>

                    <Button Content="Remove vSwitch"
                            Click="btnDeleteSwitch_Click"
                            Margin="0,0,0,4" 
                            Height="40"/>

                    <Button Content="Refresh"
                            Click="btnRefreshNIC_Click"
                            Height="40"/>

                </StackPanel>

            </Grid>

        </Border>

        <!-- ===================== -->
        <!-- VLANs                 -->
        <!-- ===================== -->

        <Border Grid.Row="2"
                BorderBrush="Gray"
                BorderThickness="1"
                CornerRadius="4"
                Padding="15"
                Margin="0,0,0,15">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>

                <StackPanel>

                    <TextBlock Text="Virtual Adapters (VLANs)"
                               FontSize="16"
                               FontWeight="Bold"
                               Margin="0,0,0,10"/>

                    <ListBox Name="lstVlans"
                             Height="140">

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding ColorHex}"
                                        CornerRadius="4"
                                        Padding="8,4"
                                        Margin="0,1">
                                    <TextBlock Text="{Binding Display}"
                                               Foreground="White"
                                               FontWeight="SemiBold"/>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>

                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding"                    Value="0"/>
                                <Setter Property="Margin"                     Value="0,0,0,2"/>
                            </Style>
                        </ListBox.ItemContainerStyle>

                    </ListBox>

                </StackPanel>

                <StackPanel Grid.Column="1"
                            Margin="15,32,0,0">

                    <Button Content="Add VLAN"
                            Click="btnAddVlan_Click"
                            Margin="0,0,0,4"
                            Height="40"/>

                    <!--   <Button Content="Edit VLAN"
                            Click="btnEditVlan_Click"
                            Margin="0,0,0,4"/> -->

                    <Button Content="Remove VLAN"
                            Click="btnDeleteVlan_Click"
                            Margin="0,0,0,4"
                            Height="40"/>

                    <Button Content="Refresh"
                            Click="btnRefreshVLAN_Click"
                            Height="40"/>

                </StackPanel>

            </Grid>

        </Border>

        <!-- ===================== -->
        <!-- CONSOLE               -->
        <!-- ===================== -->

        <Border Grid.Row="3"
                BorderBrush="Gray"
                BorderThickness="1"
                CornerRadius="4"
                Padding="10">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Console"
                           FontSize="16"
                           FontWeight="Bold"/>

             <RichTextBox Name="txtConsole"
             Grid.Row="1"
             FontFamily="Consolas"
             FontSize="13"
             IsReadOnly="True"
             VerticalScrollBarVisibility="Auto"
             HorizontalScrollBarVisibility="Auto"/>


            </Grid>

        </Border>

        <!-- ===================== -->
        <!-- VOILE ADMIN           -->
        <!-- ===================== -->

        <Grid Name="voileAdmin"
      Grid.RowSpan="4"
      Background="#80000000"
      Visibility="Collapsed"
      Panel.ZIndex="99">

            <Border Background="White"
            CornerRadius="8"
            Padding="40,30"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

                <StackPanel HorizontalAlignment="Center">

                    <TextBlock Text="🔒"
                       FontSize="48"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,10"/>

                    <TextBlock Text="Droits administrateur requis !"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="Red"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,8"/>

                    <TextBlock Text="Relancez HyperTrunk avec clic droit → Exécuter en tant qu'administrateur."
                       FontSize="13"
                       Foreground="Gray"
                       HorizontalAlignment="Center"/>

                </StackPanel>

            </Border>

        </Grid>

        <!-- ===================== -->
        <!-- VOILE HYPER-V         -->
        <!-- ===================== -->
        <Grid Name="voileHyperV"
      Grid.RowSpan="4"
      Background="#80000000"
      Visibility="Collapsed"
      Panel.ZIndex="99">

            <Border Background="White"
            CornerRadius="8"
            Padding="40,30"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

                <StackPanel HorizontalAlignment="Center">

                    <TextBlock Text="⚠"
                       FontSize="48"
                       HorizontalAlignment="Center"
                       Foreground="Red"
                       Margin="0,0,0,10"/>

                    <TextBlock Text="Hyper-V n'est pas activé sur cet ordinateur !"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="Red"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,8"/>

                    <TextBlock Text="Activez Hyper-V dans les fonctionnalités Windows puis redémarrez."
                       FontSize="13"
                       Foreground="Gray"
                       HorizontalAlignment="Center"/>

                </StackPanel>

            </Border>

        </Grid>
    </Grid>

</Window>